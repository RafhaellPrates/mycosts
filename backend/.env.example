# Porta do servidor
PORT=3000
# Postgres. Em producao (Render) usar a URI do Session pooler do Supabase.
DATABASE_URL=postgresql://usuario:senha@host:5432/postgres
# Segredo do JWT, minimo 32 caracteres. Gerar com:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# Validade do token de login
JWT_EXPIRES_IN=30d
# Web Push do lembrete do dia 5 (opcional). Gerar o par com:
# npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contato do dono do app que vai junto no push (mailto: ou https:)
VAPID_SUBJECT=mailto:voce@exemplo.com
