# Porta do servidor
PORT=3000
# Origens liberadas no CORS, separadas por virgula (front local e Vercel)
CORS_ORIGIN=http://localhost:5173
# Postgres. Em producao (Render) usar a URI do Session pooler do Supabase.
DATABASE_URL=postgresql://usuario:senha@host:5432/postgres
# Segredo do JWT, minimo 32 caracteres. Gerar com:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# Validade do token de login
JWT_EXPIRES_IN=30d
